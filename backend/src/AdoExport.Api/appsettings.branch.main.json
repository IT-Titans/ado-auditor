{
  // Applies to images built from the branch main. Those are the images the pipeline
  // deploys to the production App Services, and the only ones. Images built from dev
  // keep the defaults from appsettings.json.
  //
  // TEMPORARY. Remove the "RateLimiting" section once RATELIMITING__TRUSTEDPROXYKEY and
  // NUXT_PROXY_KEY are set on the production App Services.
  //
  // Until those two are set, the backend counts every visitor under the address of the
  // frontend server, so all visitors share one budget. The defaults (5 audit starts,
  // 3 mails, 300 requests per ten minutes) are meant for a single visitor and would be
  // used up by a handful of people at once. The values below are sized for all visitors
  // together. With the keys set the budgets are per visitor again, and these values
  // would be far too generous for one.
  "RateLimiting": {
    "AuditPermitLimit": 60,
    "MailPermitLimit": 20,
    "GlobalPermitLimit": 3000
  }
}
