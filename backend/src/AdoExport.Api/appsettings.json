{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feedback": {
    "Sender": "DoNotReply@mail.ado-auditor.com",
    "Receiver": ""
  },
  "Contact": {
    "Sender": "DoNotReply@mail.ado-auditor.com",
    "Receiver": ""
  },
  "UserConsent": {
    "Sender": "DoNotReply@mail.ado-auditor.com",
    "Receiver": ""
  },
  "AuditLogs": {
    "Sender": "DoNotReply@mail.ado-auditor.com",
    "Receiver": ""
  },
  "ErrorReports": {
    "Sender": "DoNotReply@mail.ado-auditor.com",
    "Receiver": ""
  },
  "AzureCommunicationService": {
    "ConnectionString": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Window": "00:10:00",
    "MailPermitLimit": 3,
    "AuditPermitLimit": 5,
    "GlobalPermitLimit": 300,
    "QueueLimit": 0,
    "TrustedProxyKey": ""
  },
  "Caches":{
    "CacheExpiry": "00:30:00",
    "CacheType": "Memory"
  },
  "RedisCache": {
    "Configuration": "redis:6379"
  }
}
