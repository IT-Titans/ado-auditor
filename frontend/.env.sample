# Canonical Redirect Settings
NUXT_SHOULD_REDIRECT=false
# Specifies the URL where to redirect to
NUXT_REDIRECT_TO_URL="ado-auditor.com"

# API Proxy Settings
# Specifies the API URL
NUXT_API_URL=""
# Specifies the secret sent to the backend together with the address of the visitor.
# Needs to match RATELIMITING__TRUSTEDPROXYKEY of the backend. Empty switches it off
NUXT_PROXY_KEY=""

# Caching Settings
# Specifices the audit expire time in minutes
NUXT_PUBLIC_AUDIT_EXPIRE_TIME=30