###
### Api Configuration (backend)
###

# The services environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Development
# The azure communication service connection string. Can be obtained in the web portal
AZURECOMMUNICATIONSERVICE__CONNECTIONSTRING=
# The feedback sender mail address (from which mail address the feedback is sent from)
FEEDBACK__SENDER="DoNotReply@mail.ado-auditor.com"
# The feedback receiver mail address (to which mail the feedback should be sent to)
FEEDBACK__RECEIVER=
# The contact inquiry sender mail address (from which mail address the contact inquiry is sent from)
CONTACT__SENDER="DoNotReply@mail.ado-auditor.com"
# The contact inquiry receiver mail address (to which mail the contact inquiry should be sent to)
CONTACT__RECEIVER=
# The user consent sender mail address (from which mail address the user consent data is sent from)
USERCONSENT__SENDER="DoNotReply@mail.ado-auditor.com"
# The user consent receiver mail address (to which mail the user consent data should be sent to)
USERCONSENT__RECEIVER=
# The audit logs sender mail address (from which mail address the audit logs data is sent from)
AUDITLOGS__SENDER="DoNotReply@mail.ado-auditor.com"
# The audit logs receiver mail address (to which mail the audit logs data should be sent to)
AUDITLOGS__RECEIVER=
# The error reports sender mail address (from which mail address the error reports is sent from)
ERRORREPORTS__SENDER="DoNotReply@mail.ado-auditor.com"
# The error reports receiver mail address (to which mail the error reports should be sent to)
ERRORREPORTS__RECEIVER=
# The timespan after which a cached item expires at (e.g. "00:30:00" for 30min)
CACHES__CACHEEXPIRY="00:30:00"
# The cache type (Memory / Redis)
CACHES__CACHETYPE=Memory
# The redis configuration / connection string
REDISCACHE__CONFIGURATION=redis:6379
# Whether request rate limiting is enforced. Leave this on outside of load tests
RATELIMITING__ENABLED=true
# The window over which every limit below is counted (e.g. "00:10:00" for 10min)
RATELIMITING__WINDOW="00:10:00"
# How many contact or feedback submissions one client may send per window.
# Each accepted request puts a mail into an IT Titans mailbox
RATELIMITING__MAILPERMITLIMIT=3
# How many audits one client may start per window
RATELIMITING__AUDITPERMITLIMIT=5
# How many requests one client may send to every other endpoint per window
RATELIMITING__GLOBALPERMITLIMIT=300
# How many requests may wait for a free slot instead of being rejected straight away
RATELIMITING__QUEUELIMIT=0
# The secret the frontend presents so that the visitor address it passes on is believed.
# Without it every visitor is counted under the address of the frontend server, and they
# all share one budget. Needs at least 32 characters and the same value as NUXT_PROXY_KEY.
# Leaving it empty switches this off
RATELIMITING__TRUSTEDPROXYKEY=

###
### App Configuration (frontend)
###

# Canonical Redirect Settings
# Whether requests on a non-canonical host or on http are redirected
NUXT_SHOULD_REDIRECT=false
# The URL where to redirect to. Leaving this empty disables the redirect
NUXT_REDIRECT_TO_URL=""

# API Proxy Settings
# The backend api url to use for the frontend
NUXT_API_URL=http://api:8080
# The secret sent to the backend together with the address of the visitor, so the backend
# can count its request limits per visitor. Same value as RATELIMITING__TRUSTEDPROXYKEY.
# Leaving it empty switches this off
NUXT_PROXY_KEY=

# Public Settings
#
# Caching Settings
# The time in minutes after which an audit expires. Needs to match with the backend configuration
NUXT_PUBLIC_AUDIT_EXPIRE_TIME=30

###
### Redis Configuration (cache)
###

# The redis version to use
REDIS_VERSION=8
# The redis tcp port on which the service will be available
REDIS_PORT=6379
